# =============================================================================
# 2. Documentación Interna del Proyecto (Internal Documentation)
# =============================================================================
/docs/

# =============================================================================
# 3. Seguridad, Credenciales y Archivos Sensibles (Security & Secrets)
# =============================================================================
# Variables de entorno (nunca subir credenciales reales)
.env
.env.*
!.env.example
.env.backup
.env.production
.env.local
.env.testing

# Autenticación de paquetes y tokens
/auth.json
credentials.json
client_secret*.json
token.json
*.keystore

# Certificados y llaves criptográficas (SSL, SSH, OAuth)
*.pem
*.key
*.crt
*.pfx
*.p12
*.pub
id_rsa*
id_ed25519*
oauth-private.key
oauth-public.key
/storage/*.key
/storage/oauth-*.key

# =============================================================================
# 4. Logs, Debugging y Telemetría Local
# =============================================================================
*.log
/storage/logs/*.log
/storage/debugbar/
/storage/pail/

# =============================================================================
# 5. Almacenamiento Local de Laravel (Storage & Framework Cache)
# =============================================================================
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitignore

/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore

# =============================================================================
# 6. Bases de Datos, Respaldos y Volcados (Databases & Backups)
# =============================================================================
*.sql
*.sqlite
*.sqlite-journal
*.db
*.dump
*.bak
*.backup
*.tar
*.tar.gz
*.zip

# =============================================================================
# 7. Dependencias y Compilación (Dependencies & Build Artifacts)
# =============================================================================
/node_modules/
/vendor/
/public/build/
/public/hot
/public/storage
/public/fonts-manifest.dev.json

